{
  "info": {
    "name": "Service Ticketing - Tickets",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "ticketId",
      "value": ""
    },
    {
      "key": "assigneeId",
      "value": "11111111-1111-1111-1111-111111111111"
    }
  ],
  "item": [
    {
      "name": "Create Ticket",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tickets",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Portal login issue\",\n  \"description\": \"Customer cannot access the service portal after password reset.\",\n  \"priority\": \"HIGH\",\n  \"category\": \"ACCESS\"\n}"
        }
      }
    },
    {
      "name": "Search Tickets",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tickets/search?status=OPEN&page=0&size=20&sort=createdAt,desc"
      }
    },
    {
      "name": "Get Ticket",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}"
      }
    },
    {
      "name": "Update Ticket",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Portal login issue after MFA reset\",\n  \"description\": \"Customer cannot access the service portal after password and MFA reset.\",\n  \"priority\": \"HIGH\",\n  \"category\": \"ACCESS\"\n}"
        }
      }
    },
    {
      "name": "Assign Ticket",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/assignment",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"assigneeId\": \"{{assigneeId}}\"\n}"
        }
      }
    },
    {
      "name": "Change Status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/status",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"reason\": \"Service manager started investigation\"\n}"
        }
      }
    },
    {
      "name": "Resolve Ticket",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/resolve"
      }
    },
    {
      "name": "Reopen Ticket",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/reopen"
      }
    },
    {
      "name": "Add Comment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/comments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"We verified the account and found the MFA device is out of sync.\",\n  \"internal\": false\n}"
        }
      }
    },
    {
      "name": "List Comments",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/comments/search?page=0&size=20&sort=createdAt,asc"
      }
    },
    {
      "name": "Add Attachment Metadata",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/attachments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fileName\": \"login-error.png\",\n  \"contentType\": \"image/png\",\n  \"fileSizeBytes\": 204800,\n  \"storageKey\": \"tickets/2026/TCK-2026-000001/login-error.png\",\n  \"checksumSha256\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n}"
        }
      }
    },
    {
      "name": "List Attachments",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/attachments/search?page=0&size=20&sort=createdAt,desc"
      }
    },
    {
      "name": "List History",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/tickets/{{ticketId}}/history/search?page=0&size=20&sort=createdAt,desc"
      }
    }
  ]
}
